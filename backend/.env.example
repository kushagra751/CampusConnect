# Copy to backend/.env and fill in. Never commit real values.
PORT=3000
MONGO_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/campusconnect
# Long random string, e.g. `openssl rand -hex 48`
JWT_SECRET=<jwt-secret>
# Gmail account + app password used to send OTP emails
ADMIN_EMAIL=<sender-email>
ADMIN_PASSWORD=<email-app-password>
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173
